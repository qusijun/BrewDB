statement ok
create table query_planner_orders (id int, amount int);

statement ok
insert into query_planner_orders values
  (1, 10),
  (1, 15),
  (2, 20),
  (3, 30),
  (3, 35),
  (3, 40);

query I
select count(*) from query_planner_orders;
----
6

query I
select count() from query_planner_orders;
----
6

query I
select distinct id from query_planner_orders order by id desc limit 2;
----
3
2

query II
select id, count(*) from query_planner_orders group by 1 order by 1;
----
1 2
2 1
3 3

query II
select id as order_id, count(*) from query_planner_orders group by order_id order by order_id;
----
1 2
2 1
3 3

query I
select id from query_planner_orders group by id having count(*) > 1 order by id;
----
1
3

query II
select id, count(*) as order_count
from query_planner_orders
group by id
having order_count > 1
order by 1;
----
1 2
3 3

query I
select id as order_id from query_planner_orders order by 1 desc limit 1;
----
3

statement ok
create table statement_bind_exprs (id int, name text, order_date date);

statement ok
insert into statement_bind_exprs values
  (1, 'PROMO BRASS', date '1995-03-14'),
  (2, 'STANDARD BRASS', date '1995-03-20'),
  (3, 'PROMO COPPER', date '1995-06-16');

query I
select id from statement_bind_exprs where name like '%BRASS' order by id;
----
1
2

query I
select id
from statement_bind_exprs
where order_date >= date '1995-03-15'
  and order_date < date '1995-03-15' + interval '3' month
order by id;
----
2

query I
select sum(case when name like 'PROMO%' then 1 else 0 end) from statement_bind_exprs;
----
2

query I
select id from statement_bind_exprs where id in (1, 3) order by id;
----
1
3

query I
select extract(year from order_date) from statement_bind_exprs where id = 1;
----
1995

query I
select count(*) from statement_bind_exprs where substring(name from 1 for 5) = 'PROMO';
----
2

query I
select renamed_id
from (select id from statement_bind_exprs where name like 'PROMO%') as promo_items (renamed_id)
order by renamed_id;
----
1
3

query I
select id
from statement_bind_exprs
where id < (select max(id) from statement_bind_exprs)
order by id;
----
1
2

query I
select id
from statement_bind_exprs
where id in (select id from statement_bind_exprs where name like 'PROMO%')
order by id;
----
1
3

query I
select count(*)
from statement_bind_exprs
where exists (select id from statement_bind_exprs where name like 'STANDARD%');
----
3

query I
select id
from statement_bind_exprs as e
where id in (
  select i.id
  from statement_bind_exprs as i
  where i.id = e.id and i.name like 'PROMO%'
)
order by id;
----
1
3

query I
select count(*)
from statement_bind_exprs as e
where exists (
  select *
  from statement_bind_exprs as i
  where i.id = e.id and i.name like 'STANDARD%'
);
----
1
