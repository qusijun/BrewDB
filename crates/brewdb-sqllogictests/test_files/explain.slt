control substitution on

statement ok
create table explain_orders (id int, amount int);

statement ok
insert into explain_orders values (1, 10), (2, 20), (3, 30);

query TT
explain select count(id) from explain_orders;
----
logical_plan Aggregate:<slt:ignore>
physical_plan AggregateExec:<slt:ignore>

query TT
explain format tree select count(id) from explain_orders;
----
physical_plan <slt:ignore>PaimonNativeScanExec<slt:ignore>

query TT
explain format pgjson select count(id) from explain_orders;
----
logical_plan <slt:ignore>"Plan":<slt:ignore>"Node Type": "Aggregate"<slt:ignore>"Node Type": "TableScan"<slt:ignore>

query TT
explain analyze select count(id) from explain_orders;
----
Plan with Metrics AggregateExec:<slt:ignore>PaimonNativeScanExec: DataSourceExec:<slt:ignore>

query TT
explain copy from '$TEST_DATA_DIR/copy_orders.csv' to explain_orders with (format csv, header true);
----
logical_plan Dml: op=[Insert Into] table=[managed_paimon_catalog.brewdb.explain_orders]<slt:ignore>
physical_plan PaimonCommitExec: table=brewdb.explain_orders<slt:ignore>
